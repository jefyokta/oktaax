{
    "name": "jefyokta/oktaax",
    "description": "HTTP and WebSocket server library for Swoole",
    "type": "library",
    "keywords": [
        "http-library",
        "openswoole",
        "php-server",
        "openswoole-library",
        "php-microframework",
        "event-driven",
        "php-websocket",
        "websocket",
        "php",
        "real-time"
    ],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Oktaax\\": "src/"
        },
        "files": [
            "src/Utils/Functions.php"
        ]
    },
    "authors": [
        {
            "name": "Jepi Oktamipa",
            "email": "jefyokta50@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "ext-swoole": "*",
        "firebase/php-jwt": "^7.2",
        "jefyokta/php-promise": "^0.0.4",
        "nikic/fast-route": "^1.3"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/jefyokta/oktaax"
        }
    ],
    "require-dev": {
        "pestphp/pest": "^5.3",
        "mockery/mockery": "^1.6",
        "swoole/ide-helper": "@dev",
        "phpstan/phpstan": "^2.2",
        "illuminate/database": "^12.0 || ^13.0"
    },
    "suggest": {
        "illuminate/database": "Required for optional Eloquent support (^12.0 || ^13.0)."
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:integration": "OKTAAX_INTEGRATION=1 pest tests/Integration",
        "analyse": "phpstan analyse --no-progress"
    }
}
